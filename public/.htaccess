DirectoryIndex index.html
RewriteEngine On
RewriteRule ^auth/tesla/callback/?$ api/tesla.php?action=callback [QSA,L]
RewriteRule ^root/?$ root.php [L]
RewriteRule ^faq/?$ faq.html [L]
RewriteRule ^root/faq/?$ root-faq.php [L]
RewriteRule ^api/stations/?$ api/stations.php [L]
RewriteRule ^api/spark-snapshot\.json$ - [F,L,NC]

AddType application/manifest+json .webmanifest
